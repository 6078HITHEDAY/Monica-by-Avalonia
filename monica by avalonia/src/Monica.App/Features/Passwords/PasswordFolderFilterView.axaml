<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Monica.App.ViewModels"
             x:Class="Monica.App.Features.Passwords.PasswordFolderFilterView"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto,Auto">
        <Border IsVisible="{Binding HasSelectedPasswords}"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="10,8"
                Background="{DynamicResource AccentFillColorTertiaryBrush}"
                Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ic:FluentIcon Icon="CheckboxChecked" FontSize="18" />
                    <TextBlock Text="{Binding SelectedPasswordCountText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Classes="passwordCommand" Margin="0,0,6,6" Command="{Binding FavoriteSelectedPasswordsCommand}" ToolTip.Tip="{Binding L.BatchFavorite}" AutomationProperties.Name="{Binding L.BatchFavorite}"><ic:FluentIcon Icon="Star" FontSize="18" /></Button>
                    <Button Classes="passwordCommand" Margin="0,0,6,6" Command="{Binding MoveSelectedPasswordsToCategoryCommand}" ToolTip.Tip="{Binding L.MoveToFolder}" AutomationProperties.Name="{Binding L.MoveToFolder}"><ic:FluentIcon Icon="Folder" FontSize="18" /></Button>
                    <Button Classes="passwordCommand" Margin="0,0,6,6" Command="{Binding StackSelectedPasswordsCommand}" IsEnabled="{Binding CanStackSelectedPasswords}" ToolTip.Tip="{Binding L.StackSelectedPasswords}" AutomationProperties.Name="{Binding L.StackSelectedPasswords}"><ic:FluentIcon Icon="Library" FontSize="18" /></Button>
                    <Button Classes="passwordCommand" Margin="0,0,6,6" Command="{Binding ArchiveSelectedPasswordsCommand}" ToolTip.Tip="{Binding L.BatchArchive}" AutomationProperties.Name="{Binding L.BatchArchive}"><ic:FluentIcon Icon="FolderOpen" FontSize="18" /></Button>
                    <Button Classes="passwordCommand" Margin="0,0,6,6" Command="{Binding DeleteSelectedPasswordsCommand}" ToolTip.Tip="{Binding L.BatchDelete}" AutomationProperties.Name="{Binding L.BatchDelete}"><ic:FluentIcon Icon="Delete" FontSize="18" /></Button>
                    <Button Classes="passwordCommand" Margin="0,0,0,6" Command="{Binding ClearPasswordSelectionCommand}" ToolTip.Tip="{Binding L.Cancel}" AutomationProperties.Name="{Binding L.Cancel}"><ic:FluentIcon Icon="Dismiss" FontSize="18" /></Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Border x:Name="CompactFolderCommands"
                Grid.Row="1"
                Padding="16,0,16,10"
                Background="Transparent">
            <Grid ColumnDefinitions="1.2*,*,Auto,Auto,Auto"
                  ColumnSpacing="8"
                  MinHeight="36"
                  MinWidth="0">
                <ComboBox x:Name="CompactPasswordFolderPicker"
                          ItemsSource="{Binding PasswordFolderFilters}"
                          SelectedItem="{Binding SelectedPasswordFolderFilter}"
                          PlaceholderText="{Binding L.Folders}"
                          MinWidth="0"
                          Height="36"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding L.Folders}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PasswordFolderFilterChoice">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinWidth="0">
                                <TextBlock Text="{Binding FolderDisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                                <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Grid.Column="1" Text="{Binding NewFolderName}" PlaceholderText="{Binding L.NewFolder}" MinWidth="0" Height="36" VerticalAlignment="Center" AutomationProperties.Name="{Binding L.NewFolder}" />
                <Button Grid.Column="2" Classes="passwordInlineCommand" Command="{Binding CreatePasswordFolderCommand}" ToolTip.Tip="{Binding L.CreateFolder}" AutomationProperties.Name="{Binding L.CreateFolder}" Width="36" Height="36" Padding="0"><ic:FluentIcon Icon="FolderAdd" FontSize="15" /></Button>
                <Button Grid.Column="3" Classes="passwordInlineCommand" Command="{Binding RenameSelectedPasswordFolderCommand}" IsEnabled="{Binding CanManageSelectedPasswordFolder}" ToolTip.Tip="{Binding L.RenameFolder}" AutomationProperties.Name="{Binding L.RenameFolder}" Width="36" Height="36" Padding="0"><ic:FluentIcon Icon="Edit" FontSize="14" /></Button>
                <Button Grid.Column="4" Classes="passwordInlineCommand" Command="{Binding DeleteSelectedPasswordFolderCommand}" IsEnabled="{Binding CanManageSelectedPasswordFolder}" ToolTip.Tip="{Binding L.DeleteFolder}" AutomationProperties.Name="{Binding L.DeleteFolder}" Width="36" Height="36" Padding="0"><ic:FluentIcon Icon="Delete" FontSize="14" /></Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
