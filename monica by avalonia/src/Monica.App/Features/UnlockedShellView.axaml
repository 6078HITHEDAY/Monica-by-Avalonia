<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:local="using:Monica.App"
             xmlns:vm="using:Monica.App.ViewModels"
             x:Class="Monica.App.Features.UnlockedShellView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <StyleInclude Source="/Controls/UnlockedShellStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="*,32">
        <fa:FANavigationView x:Name="VaultNavigationView"
                             Grid.Row="0"
                             Classes="shellNavigation"
                             PaneDisplayMode="LeftCompact"
                             IsPaneOpen="False"
                             IsBackButtonVisible="False"
                             IsSettingsVisible="False"
                             AlwaysShowHeader="False"
                             CompactPaneLength="48"
                             OpenPaneLength="248"
                             CompactModeThresholdWidth="720"
                             ExpandedModeThresholdWidth="1280"
                             Background="{DynamicResource LayerFillColorDefaultBrush}"
                             PaneOpening="NavigationView_OnPaneOpening"
                             PaneOpened="NavigationView_OnPaneOpened"
                             PaneClosing="NavigationView_OnPaneClosing"
                             PaneClosed="NavigationView_OnPaneClosed"
                             DisplayModeChanged="NavigationView_OnDisplayModeChanged"
                             SelectionChanged="NavigationView_OnSelectionChanged"
                             ItemInvoked="NavigationView_OnItemInvoked">
            <fa:FANavigationView.MenuItems>
                <fa:FANavigationViewItemHeader Classes="shellNavHeader" Content="{Binding L.VaultNavigationGroup}" Tag="Vault" />
                <fa:FANavigationViewItem Classes="shellNavItem" Content="{Binding L.Passwords}" Tag="Passwords">
                    <fa:FANavigationViewItem.IconSource>
                        <fa:FASymbolIconSource Symbol="Permissions" />
                    </fa:FANavigationViewItem.IconSource>
                </fa:FANavigationViewItem>
            </fa:FANavigationView.MenuItems>

            <Grid x:Name="WorkspaceContentGrid" Margin="0" RowDefinitions="Auto,*" Background="{DynamicResource LayerFillColorDefaultBrush}">
                <Border Grid.Row="0" Classes="workspaceRecoverableStatus" IsVisible="{Binding HasRecoverableStatusMessage}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <ic:FluentIcon Icon="Warning" FontSize="18" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="workspaceCommand" Command="{Binding LoadCommand}" ToolTip.Tip="{Binding L.Refresh}" AutomationProperties.Name="{Binding L.Refresh}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:FluentIcon Icon="ArrowClockwise" FontSize="16" />
                                <TextBlock Text="{Binding L.Refresh}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ContentControl x:Name="WorkspaceHostSlot" Grid.Row="1" />
            </Grid>
        </fa:FANavigationView>

        <Border x:Name="ShellStatusBar" Grid.Row="1" Classes="shellStatusBar">
            <Border x:Name="ShellStatusBarContent" Padding="12,0" ClipToBounds="True">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ic:FluentIcon Icon="LockClosed" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Classes="shellStatusText" Text="{Binding ShellVaultText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ic:FluentIcon Icon="ArrowSync" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Classes="shellStatusText" Text="{Binding ShellSyncText}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Classes="shellStatusText"
                               Text="{Binding ShellPageText}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Border>

        <Border Grid.RowSpan="2"
                IsVisible="{Binding IsLoadingVault}"
                Background="{DynamicResource OverlayFillColorDefaultBrush}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ClipToBounds="True">
            <Border Width="360"
                    MaxWidth="360"
                    Margin="24"
                    Padding="20"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding L[VaultLoadTitle]}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding VaultLoadStageText}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="4" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
