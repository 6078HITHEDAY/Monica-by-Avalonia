<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls">
    <Style Selector="Border.shellStatusBar">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="TextBlock.shellStatusText">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="fa|FANavigationView.shellNavigation">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    </Style>
    <!-- Compact rail: keep icon hit targets centered and avoid cramped chrome. -->
    <Style Selector="fa|FANavigationView.shellNavigation /template/ Button#TogglePaneButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="4,4,4,2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="fa|FANavigationViewItem.shellNavItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="4,1" />
    </Style>
    <Style Selector="fa|FANavigationViewItemHeader.shellNavHeader">
        <Setter Property="Margin" Value="12,10,12,4" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="fa|FANavigationViewItemHeader.shellNavHeader.compactHidden">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="fa|FANavigationViewItemSeparator.shellNavSeparator.compactHidden">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="fa|FANavigationViewItemSeparator.shellNavSeparator">
        <Setter Property="Margin" Value="12,6" />
    </Style>
</Styles>
