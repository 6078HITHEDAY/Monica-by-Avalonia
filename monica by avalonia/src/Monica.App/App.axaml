<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="using:FluentAvalonia.Styling"
             x:Class="Monica.App.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Monica-only tokens. FluentAvalonia supplies standard Fill/Stroke/Text/Accent brushes. -->
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#D8D8D8" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#66000000" />
            <SolidColorBrush x:Key="MonicaBarcodeSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MonicaOverlayTextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MonicaOverlayTextSecondaryBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="MonicaAvatarForegroundBrush" Color="#FFFFFF" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#D8D8D8" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="MonicaBarcodeSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MonicaOverlayTextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MonicaOverlayTextSecondaryBrush" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="MonicaAvatarForegroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="MonicaBarcodeSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MonicaOverlayTextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MonicaOverlayTextSecondaryBrush" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="MonicaAvatarForegroundBrush" Color="#101010" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static styling:FluentAvaloniaTheme.HighContrastTheme}">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="MonicaBarcodeSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MonicaOverlayTextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MonicaOverlayTextSecondaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MonicaAvatarForegroundBrush" Color="#000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <styling:FluentAvaloniaTheme PreferSystemTheme="False"
                                     PreferUserAccentColor="True" />
        <StyleInclude Source="/Controls/VaultShellStyles.axaml" />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Noto Sans CJK SC" />
        </Style>

        <Style Selector="Button.StatusBarButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.StatusBarButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>

        <Style Selector="Button.IconButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.IconButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style Selector="ToggleButton.FilterChip">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.FilterChip:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.FilterChip:checked">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Application.Styles>
</Application>
